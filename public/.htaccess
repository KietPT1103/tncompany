RewriteEngine On

# Let the PHP API handle its own requests.
RewriteRule ^api/ - [L]

# Canonicalize the legacy home path.
RewriteRule ^home/?$ / [R=301,L]

# Serve dynamic SEO article pages and sitemap.
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^bai-viet/?$ /tin-tuc [R=301,L]
RewriteRule ^bai-viet/([^/]+)/?$ /tin-tuc/$1 [R=301,L]
RewriteRule ^tin-tuc/?$ seo-article-page.php [L,QSA]
RewriteRule ^tin-tuc/([^/]+)/?$ seo-article-page.php?slug=$1 [L,QSA]

# Serve prerendered public pages without forcing a trailing slash.
RewriteRule ^(ca-phe-ong-quan|tiem-lau-ong-quan|ong-quan-farm)$ $1/index.html [L]

# Serve real files and directories as-is.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Fallback all frontend routes to the SPA entry.
RewriteRule ^ index.html [L]
