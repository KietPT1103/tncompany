APP_ENV=local
APP_DEBUG=true
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=tn_company_local
DB_USER=tn_company_dev
DB_PASSWORD=tn_company_local_2026

VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=http://127.0.0.1:8000
VITE_SITE_URL=https://tnservice.vn

PUSHER_ENABLED=false
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1

# Private Cloudflare R2 storage for field-inventory receipt images.
# Create an Object Read & Write token scoped to this bucket.
RECEIPT_IMAGE_STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Leave blank for the default endpoint. Set only for EU/FedRAMP jurisdiction buckets.
R2_ENDPOINT=

# TikTok social listening
# PHP API/worker cũng đọc các biến này từ .env.local
TIKTOK_PROVIDER=
TIKTOK_REQUEST_TIMEOUT=
TIKTOK_MAX_VIDEOS=100
TIKTOK_MAX_COMMENTS_PER_VIDEO=500

# Webhook provider
TIKTOK_UPSTREAM_BASE_URL=
TIKTOK_UPSTREAM_TOKEN=

# Apify provider
TIKTOK_APIFY_TOKEN=
TIKTOK_APIFY_SEARCH_ACTOR_ID=
TIKTOK_APIFY_COMMENT_ACTOR_ID=

# OpenAI SEO article generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_SEO_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_TIMEOUT_SECONDS=90
GESTURE_EDIT_PROVIDER=local_flux
GESTURE_EDIT_MODEL=gpt-image-1
GESTURE_EDIT_SIZE=1024x1024
GESTURE_EDIT_TIMEOUT_SECONDS=180
GESTURE_EDIT_LOCAL_URL=http://127.0.0.1:8754/edit
GESTURE_EDIT_LOCAL_TOKEN=oauth-tacachuta
GESTURE_EDIT_LOCAL_MODEL_ID=black-forest-labs/FLUX.2-klein-4B
GESTURE_EDIT_LOCAL_OUTPUT_SIZE=1024x1024
