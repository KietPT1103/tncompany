VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=http://127.0.0.1:8000
VITE_SITE_URL=https://tnservice.vn

# TikTok social listening
# PHP API/worker cũng đọc các biến này từ .env.local
TIKTOK_PROVIDER=
TIKTOK_REQUEST_TIMEOUT=
TIKTOK_MAX_VIDEOS=100
TIKTOK_MAX_COMMENTS_PER_VIDEO=500

# Webhook provider
TIKTOK_UPSTREAM_BASE_URL=
TIKTOK_UPSTREAM_TOKEN=

# Apify provider
TIKTOK_APIFY_TOKEN=
TIKTOK_APIFY_SEARCH_ACTOR_ID=
TIKTOK_APIFY_COMMENT_ACTOR_ID=

# OpenAI SEO article generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_SEO_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_TIMEOUT_SECONDS=90
GESTURE_EDIT_PROVIDER=openai
GESTURE_EDIT_MODEL=gpt-image-1
GESTURE_EDIT_SIZE=1024x1024
GESTURE_EDIT_TIMEOUT_SECONDS=180
